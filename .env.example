# Copy to .env.local. Use your own Supabase project; never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only: required for demo session creation and account administration.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Enable only for a database dedicated to fictional demo records.
DEMO_MODE=false
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_PARENT_EMAIL=demo.parent@example.com
DEMO_TEACHER_EMAIL=demo.teacher@example.com

# Optional UI feature. Notifications still use the authenticated data API.
NEXT_PUBLIC_ENABLE_NOTIFICATION_HEADER=true
