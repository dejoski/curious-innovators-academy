# Supabase — use Project Settings → API in the Supabase dashboard.
# For Vercel: add these to the Production / Preview environment (no service_role in the browser).
#
# URL: "Project URL"
# Key: "anon" / "public" / default publishable key (never use service_role on the client).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server/operator aliases used by restore-target checks and non-browser scripts.
# Usually these match NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only. Required for /api/admin/users to invite/create users from Account settings.
# Never prefix this with NEXT_PUBLIC and never expose it in browser code.
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Prototype-only option to expose the legacy demo-entry buttons on `/login` in non-production
# environments. `NEXT_PUBLIC_ENABLE_DEMO_LOGIN` should remain unset or false for production.
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Production data/auth guard is fail-closed in code; this legacy flag is accepted by guard scripts.
# NEXT_PUBLIC_REQUIRE_REMOTE_DATA=true

# Tester / QA dashboard chrome — omit or set false in production. The notification dropdown reads `/api/data/notifications`.
# NEXT_PUBLIC_ENABLE_TEST_PERSONA_UI=true
# NEXT_PUBLIC_ENABLE_NOTIFICATION_HEADER=true

# Deprecated/test-only notification flag accepted by the production verifier; omit or set false.
# NEXT_PUBLIC_ENABLE_MOCK_NOTIFICATION_HEADER=false

# Public signup invite gate — client-visible string, not secret. Omit to use bundled invite default; override per environment.
# NEXT_PUBLIC_SIGNUP_INVITE_CODE=your-rotating-invite-string

# Production verifier only. Load these locally or in CI when running `npm run verify:production`.
# CIA_APP_URL=https://your-production-domain.example
# CIA_RLS_ADMIN_EMAIL=admin@example.com
# CIA_RLS_ADMIN_PASSWORD=admin-password-not-committed
# CIA_RLS_ADMIN_DISPLAY_NAME=Admin user
# CIA_RLS_PARENT_EMAIL=parent@example.com
# CIA_RLS_PARENT_PASSWORD=parent-password-not-committed
# CIA_RLS_PARENT_DISPLAY_NAME=Parent user
# CIA_RLS_TEACHER_EMAIL=teacher@example.com
# CIA_RLS_TEACHER_PASSWORD=teacher-password-not-committed
# CIA_RLS_TEACHER_DISPLAY_NAME=Teacher user
# CIA_RLS_STUDENT_EMAIL=student@example.com
# CIA_RLS_STUDENT_PASSWORD=student-password-not-committed
# CIA_RLS_STUDENT_DISPLAY_NAME=Student user
# CIA_RLS_PARENT_EXPECTED_STUDENTS=
# CIA_RLS_PARENT_FORBIDDEN_STUDENTS=
# CIA_RLS_TEACHER_EXPECTED_STUDENTS=
# CIA_RLS_TEACHER_FORBIDDEN_STUDENTS=

# Optional deployed app URL alias accepted by the production verifier.
# NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Restore-target verifier only. The script also sets CIA_VERIFY_RESTORE_TARGET=true
# when called through `npm run verify:restore-target`.
# CIA_VERIFY_RESTORE_TARGET=true
# CIA_PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref

# Supabase backup readiness and logical drill operator inputs.
# SUPABASE_ACCESS_TOKEN=your-management-api-token
# SUPABASE_PROJECT_REF=your-project-ref
# CIA_KEEP_BACKUP_ARTIFACT=false

# Local production auth guard toggles.
# CIA_AUTH_GUARD_INVALID_SUPABASE=true
# CIA_AUTH_GUARD_FAKE_SUPABASE=true
# CIA_AUTH_GUARD_PORT=3151

# Optional user provisioning helpers. Used by `npm run provision:supabase-users`.
# CIA_ADMIN_PASSWORD=admin-password-not-committed

# Optional restore-drill value checks. Comma-separated; leave blank to validate counts/refs only.
# CIA_RESTORE_REQUIRED_STUDENTS=
# CIA_RESTORE_REQUIRED_CLASSES=
# CIA_RESTORE_REQUIRED_INVOICES=
